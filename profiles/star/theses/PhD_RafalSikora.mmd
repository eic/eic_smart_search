\[C_{\mathrm{m,f}}=\frac{N_{\mathrm{reco}}+N_{\mathrm{mgr.}}^{\mathrm{out}}-N_{ \mathrm{mgr.}}^{\mathrm{in}}-N_{\mathrm{fakes}}}{N_{\mathrm{reco}}}=1+f_{ \mathrm{mgr.}}^{\mathrm{out}}-f_{\mathrm{mgr.}}^{\mathrm{in}}-f_{\mathrm{ fakes}}. \tag{11.24}\]

