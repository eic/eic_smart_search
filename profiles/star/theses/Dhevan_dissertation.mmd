\[\cos(\phi) \rightarrow \cos(\phi)-\langle\cos(\phi)\rangle\] \[\sin(\phi) \rightarrow \sin(\phi)-\langle\sin(\phi)\rangle\] \[\cos(2\Psi_{2}) \rightarrow \cos(2\Psi_{2})-\langle\cos(2\Psi_{2})\rangle\] \[\sin(2\Psi_{2}) \rightarrow \sin(2\Psi_{2})-\langle\sin(2\Psi_{2})\rangle \tag{6.24}\]

