\begin{tabular}{|c||c|c|c|} \hline i & 1 & 2 & 3 \\ \hline \hline \(a_{i}\) & 0.8 & 0.3 & -0.1 \\ \hline \(b_{i}\) & 0.8 & 0.2 & 7.6 \\ \hline \end{tabular}
