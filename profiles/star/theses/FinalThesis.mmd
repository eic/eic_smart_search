\[\begin{cases}\text{p}0&x\leq\text{p}2\\ \text{p}0+\text{p}1(x-\text{p}2)+\text{p}3(x-\text{p}2)^{2}&x\geq\text{p}2\end{cases} \tag{5.2}\]

