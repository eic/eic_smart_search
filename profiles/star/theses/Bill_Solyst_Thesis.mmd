\[A_{L}^{Y} =\frac{1}{P_{Y}}\frac{(N^{++}+N^{-+})-R_{1}(N^{--}+N^{+-})}{(N^{++ }+N^{+-})+R_{1}(N^{--}+N^{-+})} \tag{5.11a}\] \[A_{L}^{B} =\frac{1}{P_{B}}\frac{(N^{++}+N^{-+})-R_{2}(N^{+-}+N^{--})}{(N^{++ }+N^{-+})+R_{2}(N^{+-}+N^{--})}\] (5.11b) \[A_{L}^{ls} =\frac{1}{P_{Y}P_{B}}\frac{N^{++}-R_{4}N^{--}}{N^{++}+R_{4}N^{--}}\] (5.11c) \[A_{L}^{us} =\frac{1}{P_{Y}P_{B}}\frac{R_{5}N^{+-}+R_{6}N^{-+}}{R_{5}N^{+-}+R _{6}N^{-+}} \tag{5.11d}\]

