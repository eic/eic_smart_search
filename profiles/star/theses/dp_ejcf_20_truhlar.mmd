\[\begin{split}\left(p_{x}+0.6\ \text{GeV}\right)^{2}+p_{y}^{2}<1.25 \ \text{GeV}^{2},\\ 0.4\ \text{GeV}\ <|p_{y}|<0.8\ \text{GeV},\\ p_{x}>-0.27\ \text{GeV},\end{split} \tag{4.1}\]

