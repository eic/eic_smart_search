\begin{tabular}{|c|c|} \hline Event cuts & Purpose \\ \hline \({\rm TriggerId}=240020,240025\) & Select VPD-MB trigger events \\ \hline \(rank(id=0)>0\) & Select a good quality vertex \\ \hline \(\left|V_{z}\right|<30\ {\rm cm}\) & Ensure uniform acceptance and efficiency \\ \hline \(\left|V_{z}-V_{z}^{VPD}\right|<6\ {\rm cm}\) & Remove pile-up vertices \\ \hline \hline \end{tabular}
\end{table}
