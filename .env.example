APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://smartsearch:smartsearch@postgres:5432/smartsearch
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=collaboration_knowledge_chunks
VECTOR_SIZE=384

CORS_ALLOW_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,https://eic.github.io

# Local embeddings. MiniLM (384-d) runs anywhere; BAAI/bge-m3 (1024-d)
# is markedly better and fast on GPU — set VECTOR_SIZE=1024, a fresh
# QDRANT_COLLECTION name, then `docker compose exec api python
# scripts/reembed.py` (no re-crawl needed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Token cap per text at embed time; 1024 covers our chunks and keeps
# long-sequence attention within small-GPU memory (bge-m3 allows 8192).
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_BATCH_SIZE=16
# auto | cpu | cuda  (auto picks cuda when a GPU is visible; falls back to
# cpu if the CUDA load fails). GPU is only visible in the container when the
# stack is started with `make up-gpu` (docker-compose.gpu.yml override).
EMBEDDING_DEVICE=auto

# Alternative OpenAI-compatible generation providers (all have free daily
# quotas as of 2026-08). Setting a key adds the model as an arm in the
# configuration sweep's "generation" block, so it competes on the same
# benchmark with the same judge. To PROMOTE one to production, set
# OPENAI_BASE_URL + OPENAI_API_KEY + OPENAI_GENERATION_MODEL to its values.
# Free-tier rate limits (RPM) can throttle a full eval run — expect a slow
# sweep arm, not a broken one (failures fall back to extractive).
#ANTHROPIC_API_KEY=         # https://console.anthropic.com — paid; OpenAI-compat endpoint
#ANTHROPIC_MODEL=claude-haiku-4-5,claude-sonnet-5,claude-opus-5
#GEMINI_API_KEY=            # https://aistudio.google.com — ~250-1500 req/day free
#GEMINI_MODEL=gemini-3.5-flash-lite   # comma-separate for several arms
#DEEPSEEK_API_KEY=          # https://platform.deepseek.com — cheap, off-peak discounts
#DEEPSEEK_MODEL=deepseek-chat
#GROQ_API_KEY=              # https://console.groq.com — ~1k req/day free, very fast
#GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant
#OPENROUTER_API_KEY=        # https://openrouter.ai — ":free" models 50-1000 req/day
#OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Answer support gate: the service abstains ("couldn't find enough
# support") when the top chunk's cross-encoder score is below this floor.
# 0.0 = ms-marco on-topic midpoint; lower (e.g. -2.0) to abstain less on
# vague-but-answerable queries, raise to abstain more.
#MIN_RERANK_SCORE=0.0

# LLM-as-a-judge model for `make eval` / the configuration sweep. A small
# model is enough — the deterministic expected-fact check is the primary
# answer metric. Caveat: when the judge is also a candidate arm (luna), its
# grades of itself carry a self-preference bias; trust the fact check first.
EVAL_JUDGE_MODEL=gpt-5.6-luna

# PODIO data-model YAMLs (comma list of raw URLs): rendered into one doc per
# datatype/component/link for "which collection/member/relation" questions.
# Ingest via source_name edm4eic_datamodel.
#DATAMODEL_YAML_URLS=https://raw.githubusercontent.com/eic/EDM4eic/main/edm4eic.yaml,https://raw.githubusercontent.com/key4hep/EDM4hep/main/edm4hep.yaml

# Code-aware LLM tools: search_code + fetch_code_file over one GitHub org.
# Uses GITHUB_TOKEN; code-search API allows 10 req/min.
#CODE_SEARCH_ENABLED=true
#CODE_SEARCH_ORG=eic

# ePIC DD4hep constants (system IDs = ParticleID.getType() numeric values).
#EPIC_DEFINITIONS_URL=https://raw.githubusercontent.com/eic/epic/main/compact/definitions.xml
